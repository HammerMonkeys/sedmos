{
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
        "^(\\.{1,2}/.*)\\.js$": "$1",
        "^\\$lib(.*)$": "<rootDir>/src/lib$1"
    },
    "transform": {
        "^.+\\.tsx?$": [
            "ts-jest",
            {
                "useESM": true
            }
        ]
    }
}